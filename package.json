{
  "name": "flylast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test lib/*.test.ts",
    "emulators": "firebase emulators:start --project demo-flylast",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "seed:prod": "node --env-file=.env.prod --import tsx scripts/seed.ts --yes",
    "deploy:rules": "npx firebase-tools@latest deploy --only firestore:rules",
    "deploy": "npx firebase-tools@latest deploy --only apphosting,firestore:rules"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@google/genai": "^3.0.0",
    "@gsap/react": "^2.1.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.1",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "22"
  }
}
