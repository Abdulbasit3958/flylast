# Copy to .env.prod to seed your REAL Firebase project with demo data:  npm run seed:prod
# Never commit .env.prod or the service-account file (both are gitignored and excluded from deploys).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# Firebase console → Project settings → Service accounts → Generate new private key → save as service-account.json here
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Password for the 5 demo accounts in production (8+ chars). Share it with judges privately.
DEMO_PASSWORD=
